// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`valid-plan snapshots > bars compile stays stable 1`] = `
{
  "body": {
    "items": [
      {
        "label": "Sense",
        "value": 35,
      },
      {
        "label": "Act",
        "value": 40,
      },
      {
        "label": "Observe",
        "value": 25,
      },
    ],
    "type": "bars",
