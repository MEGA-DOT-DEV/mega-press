{
	"name": "@mega/press",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Portable MEGA artifact package: parse → build → mount validated press plates.",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./src/*": "./src/*",
		"./components/*": "./components/*",
		"./vendor/*": "./vendor/*",
		"./package.json": "./package.json"
	},
	"bin": {
		"press": "./bin/press.mjs"
	},
	"files": [
		"src",
		"bin",
		"cli",
		"components",
		"vendor",
		"NOTICE.md",
		"README.md",
		"AGENTS.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"build": "tsc -p tsconfig.build.json",
		"press": "node bin/press.mjs",
		"example": "vite --config example/vite.config.ts"
	},
	"devDependencies": {
		"@napi-rs/canvas": "^1.0.3",
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=22"
	}
}
