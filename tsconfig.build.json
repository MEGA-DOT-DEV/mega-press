{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowJs": false,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts", "example", "dist", "node_modules"]
}
