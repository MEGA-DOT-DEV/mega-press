{
  "schemaVersion": "press-composition/1",
  "id": "relationships-have-addresses",
  "frame": "reading",
  "kicker": "03 / DATA STRUCTURES",
  "title": "A relationship has an exact address.",
  "lead": "An illustrative ownership model. Follow the foreign key to the field it references.",
  "categories": [
    {
      "id": "primary",
      "label": "Primary key",
      "tone": "red"
    },
    {
      "id": "foreign",
      "label": "Foreign key",
      "tone": "blue"
    }
  ],
  "body": {
